---
// Forwards an old per-page URL to its section on the single-page site.
interface Props { to: string }
const { to } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL("/", Astro.site)} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body><a href={to}>Continue to {to}</a></body>
</html>
