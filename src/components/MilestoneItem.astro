---
import { getEntries, render, type CollectionEntry } from "astro:content";
import { categoryLabels } from "../lib";

interface Props { m: CollectionEntry<"milestones"> }
const { m } = Astro.props;
const { Content } = await render(m);
const people = await getEntries(m.data.people);
const sources = await getEntries(m.data.sources);
const year = m.data.date && !m.data.undated ? m.data.date.getUTCFullYear() : undefined;

// Each source links to its web page, or to its listing in the Sources tab if it has none.
const sourceHref = (s: (typeof sources)[number]) => s.data.url ?? `#source-${s.id}`;
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");

// Numbered citation markers, added to the end of the entry text (after the last paragraph
// that isn't a "To verify" note) and matching the numbered source list below it.
const markers = sources.length
  ? `<sup class="refs">${sources
      .map((s, i) => `<a href="${esc(sourceHref(s))}" title="${esc(s.data.title)}"${s.data.url ? ' rel="noopener"' : ""}>${i + 1}</a>`)
      .join("")}</sup>`
  : "";
let bodyHtml = m.rendered?.html;
if (bodyHtml && markers) {
  const ends = [...bodyHtml.matchAll(/<p>([\s\S]*?)<\/p>/g)];
  const target = [...ends].reverse().find((x) => !/^\s*<em>To verify/.test(x[1])) ?? ends.at(-1);
  if (target) {
    const at = target.index! + target[0].length - "</p>".length;
    bodyHtml = bodyHtml.slice(0, at) + markers + bodyHtml.slice(at);
  }
}
---
<li class="milestone" id={`ms-${m.id}`} data-id={m.id} data-category={m.data.category} data-year={year}>
  <div class="when">{m.data.dateLabel ?? m.data.date?.toISOString().slice(0, 10)}</div>
  <div class="what">
    <div class="meta">
      <span class={`cat cat-${m.data.category}`}>{categoryLabels[m.data.category]}</span>
    </div>
    <h3 id={m.id}><a href={`#${m.id}`}>{m.data.title}</a></h3>
    <div class="body">{bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}</div>
    {people.length > 0 && (
      <p class="links">
        {people.length > 0 && (
          <span>People: {people.map((p, i) => <>{i > 0 && ", "}<a href={`#person-${p.id}`}>{p.data.name.replace(/ \(.*\)$/, "")}</a></>)}</span>
        )}
      </p>
    )}
    {sources.length > 0 && (
      <div class="cites">
        <p class="cites-title">Source{sources.length > 1 ? "s" : ""}</p>
        <ol>
          {sources.map((s) => (
            <li>
              <a href={sourceHref(s)} rel={s.data.url ? "noopener" : undefined}>{s.data.title}</a>
              {s.data.author && <> · {s.data.author}</>}{s.data.publisher && <> · {s.data.publisher}</>}{s.data.year && <>, {s.data.year}</>}
            </li>
          ))}
        </ol>
      </div>
    )}
  </div>
</li>
<style>
  .milestone { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--rule); position: relative; }
  .when { font: 600 0.95rem/1.3 var(--sans); color: var(--accent); padding-top: 0.15rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem; }
  .cat { font: 600 0.7rem/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  h3 { margin: 0 0 0.5rem; font-size: 1.3rem; scroll-margin-top: 4rem; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .body { max-width: var(--measure); }
  .body :global(p) { margin-bottom: 0.7rem; }
  .links { font: 0.88rem/1.5 var(--sans); color: var(--ink-soft); display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0.25rem 0 0.5rem; }
  /* citation markers in the text: small linked numbers */
  .body :global(.refs) { margin-left: 0.15em; font: 600 0.7em/0 var(--sans); }
  .body :global(.refs a) { text-decoration: none; padding: 0 0.1em; }
  .body :global(.refs a:hover) { text-decoration: underline; }
  .body :global(.refs a + a)::before { content: ","; color: var(--ink-soft); margin-right: 0.1em; }
  .cites { font: 0.85rem/1.5 var(--sans); color: var(--ink-soft); max-width: var(--measure); margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed var(--rule); }
  .cites-title { margin: 0 0 0.25rem; font: 700 0.68rem/1 var(--sans); letter-spacing: 0.1em; text-transform: uppercase; }
  .cites ol { margin: 0; padding-left: 1.4rem; }
  .cites li { margin-bottom: 0.2rem; }
  .cites li::marker { font-weight: 600; color: var(--accent); }
  @media (max-width: 640px) {
    .milestone { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
