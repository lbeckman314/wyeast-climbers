---
interface Props { status: "conrad" | "sourced" | "check" | "unverified" }
const { status } = Astro.props;
const label = { conrad: "Per Ric Conrad", sourced: "Sourced", check: "Check with Conrad", unverified: "Needs a source" }[status];
const icon = { conrad: "✓", sourced: "✓", check: "≠", unverified: "?" }[status];
---
<span data-pagefind-ignore class={`badge ${status}`} title={label}><span aria-hidden="true">{icon}</span>{label}</span>
