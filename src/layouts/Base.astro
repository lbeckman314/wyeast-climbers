---
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import { site } from "../config";

interface Props { title?: string; description?: string; image?: string; imageAlt?: string }
const { title, description = "A living history of the Wy'east Climbers, the Portland mountaineering club that pioneered new routes on Mount Hood in the 1930s." } = Astro.props;
// Link previews (Messages, Slack, social sites) need absolute URLs and a JPEG/PNG image, 1200x630.
const {
  image = "/og.jpg",
  imageAlt = "A halftone 3D model of Mount Hood with the club's climbing routes marked in red, above Government Camp.",
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const fullTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const nav = [
  ["/#map", "Map"],
  ["/#timeline", "Timeline"],
  ["/#people", "People"],
  ["/#about", "About & Contribute"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.author.name && <meta name="author" content={site.author.name} />}
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f0e6" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      document.documentElement.classList.add("js"); // lets components hide things only when script can show them
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><Mark /> {site.title}</a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          The essential history of the club is Ric Conrad's{" "}
          <cite>Mount Hood: Adventures of the Wy'east Climbers, 1930–1942</cite> (Kahuna Books, 2014).
          This site summarizes and cites published sources and does not reproduce them. Photographs appear only
          with permission from their holders.
        </p>
        <p>wyeastclimbers.com · A non-commercial history and preservation project. · <a href="/#research">Research desk</a></p>
      </div>
    </footer>
    <!-- the brand mark, large and faint, tucked into the bottom-right corner of the page -->
    <div class="page-mark" aria-hidden="true"><Mark /></div>
  </body>
</html>
